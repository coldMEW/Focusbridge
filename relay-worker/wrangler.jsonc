{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "focusbridge-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNTS", "class_name": "AccountRelay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountRelay"] }]
}
